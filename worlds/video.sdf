    <!-- Overview camera: fixed 10 m east of the origin at 5 m, looking west over the takeoff point (ENU world:
         x east, y north), so a fig8 of size 6 (north +-3 m, east +-1.5 m) fills the frame. Recording service
         /overview/record_video, same as the chase camera; scenario "video": ["overview", "chase"]. -->
    <model name="overview_cam"><static>true</static><pose>10 0 5 0 0.12 3.14159</pose><link name="link">
      <sensor name="overview" type="camera">
        <always_on>1</always_on><update_rate>25</update_rate><topic>overview</topic>
        <camera><horizontal_fov>0.9</horizontal_fov><image><width>960</width><height>540</height></image>
          <clip><near>0.1</near><far>300</far></clip></camera>
        <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
          <service>/overview/record_video</service><use_sim_time>true</use_sim_time><fps>25</fps><bitrate>6000000</bitrate>
        </plugin>
      </sensor>
    </link></model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
