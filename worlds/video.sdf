<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Generated from PX4 Tools/simulation/gz/worlds/default.sdf (same physics, sun, origin) plus a floor grid
       and an overview camera, for recorded flights. Fly it with `px4ctl gz INST VEHICLE video`. -->
  <world name="video">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <!-- Floor grid, 1 m lines (5 m darker) over 30x30 m: gives the overview and chase cameras a
         reference so motion and drift show. Visual only, no collision. -->
    <model name="floor_grid"><static>true</static><link name="link">
        <visual name="gx0"><pose>0 -15 0.001 0 0 0</pose><geometry><box><size>30 0.06 0.002</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material><cast_shadows>false</cast_shadows></visual>
        <visual name="gy0"><pose>-15 0 0.001 0 0 0</pose><geometry><box><size>0.06 30 0.002</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material><cast_shadows>false</cast_shadows></visual>
        <visual name="gx1"><pose>0 -14 0.001 0 0 0</pose><geometry><box><size>30 0.025 0.002</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material><cast_shadows>false</cast_shadows></visual>
