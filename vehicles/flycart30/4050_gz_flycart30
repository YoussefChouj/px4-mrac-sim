#!/bin/sh
#
# @name DJI FlyCart 30 class coaxial octo (Gazebo)
#
# @type Octo Coaxial
#
# Numbers and sources: research/HEAVY-LIFT-REFERENCE.md. Rotor order and spin
# directions follow airframe 12001_octo_cox; arm radius 1.1 m (2200 mm wheelbase).
# Lives outside the PX4 tree; px4ctl gz copies it into an overlay etc directory.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=flycart30}

param set-default SIM_GZ_EN 1

param set-default MAV_TYPE 14
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 8

# FRD metres: upper rotors PZ -0.10, lower +0.10 (coax spacing assumed).
param set-default CA_ROTOR0_PX 0.778
param set-default CA_ROTOR0_PY 0.778
param set-default CA_ROTOR0_PZ -0.10
param set-default CA_ROTOR0_KM 0.06
param set-default CA_ROTOR1_PX 0.778
param set-default CA_ROTOR1_PY -0.778
param set-default CA_ROTOR1_PZ -0.10
param set-default CA_ROTOR1_KM -0.06
param set-default CA_ROTOR2_PX -0.778
param set-default CA_ROTOR2_PY -0.778
param set-default CA_ROTOR2_PZ -0.10
param set-default CA_ROTOR2_KM 0.06
param set-default CA_ROTOR3_PX -0.778
param set-default CA_ROTOR3_PY 0.778
param set-default CA_ROTOR3_PZ -0.10
param set-default CA_ROTOR3_KM -0.06
param set-default CA_ROTOR4_PX 0.778
param set-default CA_ROTOR4_PY -0.778
param set-default CA_ROTOR4_PZ 0.10
param set-default CA_ROTOR4_KM 0.06
param set-default CA_ROTOR5_PX 0.778
param set-default CA_ROTOR5_PY 0.778
param set-default CA_ROTOR5_PZ 0.10
param set-default CA_ROTOR5_KM -0.06
param set-default CA_ROTOR6_PX -0.778
param set-default CA_ROTOR6_PY 0.778
param set-default CA_ROTOR6_PZ 0.10
param set-default CA_ROTOR6_KM 0.06
param set-default CA_ROTOR7_PX -0.778
param set-default CA_ROTOR7_PY -0.778
param set-default CA_ROTOR7_PZ 0.10
param set-default CA_ROTOR7_KM -0.06

# Gazebo motor commands are rotor speeds in rad/s: idle 15% (as x500), max 176.
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_FUNC6 106
param set-default SIM_GZ_EC_FUNC7 107
param set-default SIM_GZ_EC_FUNC8 108
param set-default SIM_GZ_EC_MIN1 26
param set-default SIM_GZ_EC_MIN2 26
param set-default SIM_GZ_EC_MIN3 26
param set-default SIM_GZ_EC_MIN4 26
param set-default SIM_GZ_EC_MIN5 26
param set-default SIM_GZ_EC_MIN6 26
param set-default SIM_GZ_EC_MIN7 26
param set-default SIM_GZ_EC_MIN8 26
param set-default SIM_GZ_EC_MAX1 176
param set-default SIM_GZ_EC_MAX2 176
param set-default SIM_GZ_EC_MAX3 176
param set-default SIM_GZ_EC_MAX4 176
param set-default SIM_GZ_EC_MAX5 176
param set-default SIM_GZ_EC_MAX6 176
param set-default SIM_GZ_EC_MAX7 176
param set-default SIM_GZ_EC_MAX8 176

# Hover speed 124 rad/s at 95 kg: (124 - 26) / (176 - 26) = 0.65 of the output range.
param set-default MPC_THR_HOVER 0.65

param set-default NAV_DLL_ACT 2
