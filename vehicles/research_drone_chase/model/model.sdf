<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="research_drone_chase">
    <!-- Research drone (generated at fly time by vehicles/research_drone/gen_model.py) plus a massless chase camera
         1.6 m behind and 0.7 m above, welded to base_link. 640x360 at 15 fps keeps software rendering (CI, llvmpipe)
         from gating the sim too much; the recorder uses sim time, so the video plays at real speed. -->
    <include merge="true"><uri>model://research_drone</uri></include>
    <link name="chase_link">
      <pose relative_to="base_link">-1.6 0 0.7 0 0.39 0</pose>
      <inertial><mass>1e-5</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
      <sensor name="chase" type="camera">
        <always_on>1</always_on><update_rate>15</update_rate><topic>chase</topic>
        <camera><horizontal_fov>1.1</horizontal_fov><image><width>640</width><height>360</height></image>
          <clip><near>0.05</near><far>300</far></clip></camera>
        <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
          <service>/chase/record_video</service><use_sim_time>true</use_sim_time><fps>15</fps><bitrate>2000000</bitrate>
        </plugin>
      </sensor>
    </link>
    <joint name="chase_joint" type="fixed"><parent>base_link</parent><child>chase_link</child></joint>
  </model>
</sdf>
